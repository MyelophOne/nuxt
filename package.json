{
  "name": "@myelophone/nuxt",
  "version": "0.17.0",
  "type": "module",
  "author": "Aliaksandr Ivanou <aleksivanov.me@gmail.com> (https://github.com/aleksivanou)",
  "maintainers": [
    {
      "name": "MyelophOne",
      "url": "https://github.com/MyelophOne"
    }
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "./nuxt.config.ts",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-webstorage' NUXT_TELEMETRY_DEBUG=1 NUXT_PLAYGROUND=true nuxt dev playground",
    "build": "NODE_OPTIONS='--no-deprecation --no-webstorage' NUXT_TELEMETRY_DEBUG=1 NODE_ENV=production NUXT_PLAYGROUND=true nuxt build playground",
    "generate": "NODE_OPTIONS='--no-webstorage' NUXT_TELEMETRY_DEBUG=1 NODE_ENV=production NUXT_STATIC=true NUXT_PLAYGROUND=true nuxt generate playground",
    "preview": "NODE_OPTIONS='--no-webstorage' NUXT_TELEMETRY_DEBUG=1 NUXT_PLAYGROUND=true nuxt preview playground",
    "server": "node --no-deprecation --no-warnings --no-webstorage playground/.output/server/index.mjs",
    "prepare": "NODE_OPTIONS='--no-webstorage' nuxt prepare && NODE_OPTIONS='--no-webstorage' nuxt prepare playground",
    "analyze": "NODE_OPTIONS='--no-deprecation --no-webstorage' yarn nuxi analyze playground",
    "test": "yarn test:types && yarn playwright",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "playwright:install": "npx playwright install chromium",
    "playwright": "npx playwright test",
    "biome:check": "biome check --write ./app && biome check --write ./playground",
    "biome:format": "biome format --fix ./app && biome format --fix ./playground",
    "biome:all": "biome format --fix .",
    "upgrade": "npx nuxi upgrade && yarn prepare",
    "update": "yarn upgrade-interactive",
    "clear": "yarn cache clean",
    "audit": "yarn npm audit",
    "self-update": "yarn set version berry",
    "lock-update": "yarn dedupe --strategy highest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/scripts": "^1.3.8",
    "@nuxt/types": "^2.18.1",
    "@nuxtjs/fontaine": "^0.5.0",
    "@nuxtjs/robots": "^6.2.0",
    "@pinia/colada": "^1.4.2",
    "@pinia/colada-nuxt": "^1.0.2",
    "@pinia/nuxt": "^1.0.2",
    "@playwright/test": "^1.62.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@unhead/vue": "^3.4.0",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^14.4.0",
    "commitlint": "^21.2.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "markdown-it": "^15.0.0",
    "nuxt": "^4.5.2",
    "nuxt-api-party": "^4.0.0",
    "nuxt-link-checker": "^5.3.0",
    "nuxt-og-image": "^6.7.8",
    "nuxt-payload-analyzer": "^0.1.4",
    "nuxt-security": "^2.6.0",
    "nuxt-seo-utils": "^8.4.2",
    "nuxt-vitalizer": "^3.0.0",
    "pinia": "^4.0.3",
    "postcss": "^8.5.26",
    "postcss-no-important": "^11.0.0",
    "purgecss": "^8.0.0",
    "rolldown": "^1.2.5",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unstorage": "^1.17.5",
    "valibot": "^1.4.2",
    "vite": "^8.2.2",
    "vue": "^3.5.41",
    "vue-easy-lightbox": "^1.19.0",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.0"
  },
  "packageManager": "yarn@4.18.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myelophone/nuxt.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "fuse.js": "^7.5.0"
  }
}
