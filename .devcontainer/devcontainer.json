{
  "name": "Nuxt Dev",
  "build": {
    "dockerfile": "Dockerfile",
  },
  "workspaceFolder": "/app",
  "mounts": [
    "source=${localWorkspaceFolder},target=/app,type=bind,consistency=cached",
  ],
  "forwardPorts": [3000],
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "vue.volar",
        "vue.vscode-typescript-vue-plugin",
        "dbaeumer.vscode-eslint",
      ],
    },
  },
}
